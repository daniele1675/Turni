# Copia questo file come ".env" e compila le prime due righe.
# Il file .env resta solo sul tuo server: non condividerlo con nessuno.

PORTAL_USERNAME=
PORTAL_PASSWORD=

# Token per aprire l'app e il calendario. Se lo lasci vuoto ne viene generato uno
# (lo trovi nei log e in data/access_token.txt). Se lo cambi, i link vecchi smettono di funzionare.
ACCESS_TOKEN=

# Ogni quante ore rileggere i turni, e fascia notturna senza letture automatiche.
REFRESH_HOURS=4
QUIET_FROM_HOUR=23
QUIET_TO_HOUR=6

# Quante settimane leggere oltre a quella corrente.
WEEKS_AHEAD=3
WEEKS_BACK=1

TZ=Europe/Rome

# Facoltativo: webhook di Home Assistant da chiamare quando un turno cambia.
# Esempio: http://192.168.1.10:8123/api/webhook/turni-cambiati-abc123
NOTIFY_WEBHOOK_URL=

# Indirizzo della pagina dei turni (non serve cambiarlo).
PORTAL_URL=https://na.amazonmoment.com/goa/wfm/associate/schedule

# Solo se il login non viene riconosciuto da solo (selettori CSS dei campi).
LOGIN_USER_SELECTOR=
LOGIN_PASS_SELECTOR=
LOGIN_SUBMIT_SELECTOR=
